      <column caption='Order Count' datatype='integer' name='[Calculation_0178972860887040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Order ID])' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='C1033%' name='[Calculation_0178972862287873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0178972864135170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Delivery Days' datatype='integer' name='[Calculation_0178972897615875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='Shipping Days' datatype='integer' name='[Calculation_0178972913819653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
